// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A tenant: up to 3 Users share one Account with equal permissions. Brand-level
// singletons (BrandSettings, GhlSettings, newsletter routing) and all content are
// shared across an Account's members.
model Account {
  id          String   @id @default(cuid())
  name        String?
  ownerUserId String?  @unique // the creating user (scalar, not a relation, to avoid a 2nd User↔Account relation)
  // Default "assistant" recipient for collaborative edit requests (Phase 7);
  // overridable per send. Usually one of the account's members.
  assistantEmail String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[] @relation("AccountMembers")

  @@map("accounts")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String?
  email     String   @unique
  role      String   @default("user") // user | admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Account membership (tenant). Nullable during rollout; backfilled 1 account per user.
  accountId String?
  account   Account? @relation("AccountMembers", fields: [accountId], references: [id], onDelete: SetNull)

  // Relations
  drafts               Draft[]
  posts                Post[]
  apiKeys              ApiKey[]
  settings             Settings?
  brandSettings        BrandSettings?
  templates            Template[]
  socialConnections    SocialConnection[]
  twitterApiRequests   TwitterApiRequest[]
  topics               Topic[]
  articleJobs          ArticleJob[]
  llmUsage             LLMUsage[]
  wordPressConnections WordPressConnection[]
  errorLogs            ErrorLog[]
  media                Media[]
  sectionEnrichments   SectionEnrichment[]
  ghlSettings          GhlSettings?
  socialAutomationRuns SocialAutomationRun[]
  socialPostSpecs      SocialPostSpec[]

  // Newsletter pipeline — the single calendar explicitly assigned to this customer
  newsletterCalendarId String?
  newsletterCalendar   NewsletterCalendar? @relation("UserNewsletterCalendar", fields: [newsletterCalendarId], references: [id], onDelete: SetNull)
  newsletters          Newsletter[]
  newsletterOffers     NewsletterOffer[]

  @@index([newsletterCalendarId])
  @@index([accountId])
  @@map("users")
}

model Draft {
  id                      String    @id @default(cuid())
  userId                  String
  title                   String // Short title/preview
  contentRaw              String    @db.Text // User's original idea
  linkedinContent         String?   @db.Text // AI-generated LinkedIn post
  twitterContent          String?   @db.Text // AI-generated Twitter post
  facebookContent         String?   @db.Text // AI-generated Facebook post
  instagramContent        String?   @db.Text // AI-generated Instagram post
  telegramContent         String?   @db.Text // AI-generated Telegram post
  threadsContent          String?   @db.Text // AI-generated Threads post
  platforms               String // JSON array: ["linkedin", "twitter", "facebook", etc.] or "all" (or "both" for backward compatibility)
  templateId              String? // Which template was used
  attachedImage           String? // Supabase Storage URL (not base64)
  imageGenerationPrompt   String?   @db.Text // Store the prompt used for image generation
  imageGenerationProvider String? // Which provider was used (fal, openai-dalle, replicate)
  status                  String    @default("draft") // draft, published
  publishedAt             DateTime? // When the draft was published
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[] // A draft can result in multiple posts (one per platform)

  @@index([userId, status])
  @@map("drafts")
}

model Post {
  id                    String               @id @default(cuid())
  userId                String
  draftId               String? // Link back to the draft this was published from
  parentPostId          String? // For Twitter threads: link to the parent post (summary)
  threadOrder           Int? // For Twitter threads: 0 = summary, 1+ = replies (order within thread)
  platform              String // "linkedin" | "twitter" | "facebook" | "instagram" | "telegram" | "threads"
  content               String               @db.Text // The actual content that was published
  publishedAt           DateTime? // When the post was actually published (nullable for scheduled posts)
  scheduledAt           DateTime? // When the post is scheduled to be published
  postUrl               String? // URL to the published post (if available from API)
  tweetId               String? // Twitter/X tweet ID (for replies and verification)
  imageUrl              String? // URL of image published with this post (Supabase Storage URL)
  postType              String? // quote | carousel | video_reel | hook_video | ...
  mediaUrls             String[]             @default([]) // carousel / multi-image
  videoUrl              String?
  postAsStory           Boolean              @default(false)
  provider              String? // ghl | direct
  ghlPostId             String?
  automationRunId       String?
  automationRun         SocialAutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)
  slotKey               String? // F1..S6 for automation posts
  status                String               @default("published") // ready | scheduled | published | failed | deleted
  errorMsg              String? // If publishing failed, store error
  analyticsLastSyncedAt DateTime? // When analytics were last fetched
  analyticsData         Json? // Store analytics as JSON (platform-specific structure)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // Relations
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft      Draft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  parentPost Post?  @relation("PostReplies", fields: [parentPostId], references: [id], onDelete: Cascade)
  replies    Post[] @relation("PostReplies")

  @@index([userId, platform, publishedAt])
  @@index([draftId])
  @@index([userId, scheduledAt, status]) // For calendar queries
  @@index([parentPostId]) // For thread queries
  @@index([tweetId]) // For quick tweet ID lookups
  @@index([draftId, threadOrder]) // For thread ordering
  @@index([provider, status])
  @@index([automationRunId])
  @@map("posts")
}

model SocialAutomationRun {
  id             String                       @id @default(cuid())
  userId         String
  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?
  job            ArticleJob?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sitePageId     String?
  sitePage       SitePage?                    @relation(fields: [sitePageId], references: [id], onDelete: SetNull)
  scheduledDate  String // YYYY-MM-DD in user's social timezone
  status         String                       @default("pending") // pending | processing | ready | scheduling | completed | failed | cancelled
  totalSpecs     Int                          @default(12)
  completedSpecs Int                          @default(0)
  failedSpecs    Int                          @default(0)
  currentSpec    String?
  error          String?                      @db.Text
  groupId        String?
  slideCount     Int? // shared F4/F6 carousel + hook slide count (6–12), set once per run
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  posts          Post[]
  specResults    SocialAutomationSpecResult[]

  @@index([userId, status])
  @@index([jobId])
  @@index([status, updatedAt])
  @@map("social_automation_runs")
}

model SocialAutomationSpecResult {
  id           String              @id @default(cuid())
  runId        String
  run          SocialAutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  slotKey      String
  status       String              @default("pending") // pending | completed | failed
  error        String?             @db.Text
  postsCreated Int                 @default(0)
  assetsJson   Json?
  previewJson  Json? // per-platform captions + media for workflow preview (pre-GHL)
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([runId, slotKey])
  @@index([runId, status])
  @@map("social_automation_spec_results")
}

model SocialPostSpec {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotKey    String // F1..F6, S1..S6
  enabled    Boolean  @default(true)
  timeHour   Int
  timeMinute Int
  postType   String // quote | video_reel | carousel | hook_video | quote_video | pitch_carousel | pitch_hook
  isStory    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, slotKey])
  @@map("social_post_specs")
}

model GhlSettings {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ghlApiKey           String?   @db.Text // AES-256-GCM encrypted Private Integration key
  ghlLocationId       String?
  ghlUserId           String? // GHL team member who owns created posts
  accountIds          Json? // { facebook?: string, instagram?: string, linkedin?: string }
  lastVerifiedAt      DateTime?
  lastError           String?
  // Promotional email automation (one campaign per published article, sent to a tag/smart list)
  promoEmailEnabled   Boolean   @default(true)
  promoEmailTagId     String?
  promoEmailTagName   String?
  promoEmailSendTime  String?   @default("09:00") // "HH:mm" 24h, in promoEmailTimezone
  promoEmailTimezone  String?   @default("America/New_York")
  promoEmailFromName  String?
  promoEmailFromEmail String?
  // Magazine newsletter delivery (one GHL email campaign per approved edition)
  newsletterTagId     String?
  newsletterTagName   String?
  newsletterSendTime  String?   @default("09:00") // "HH:mm" 24h, in newsletterTimezone
  newsletterTimezone  String?   @default("America/New_York")
  newsletterFromName  String?
  newsletterFromEmail String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("ghl_settings")
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  provider     String // openai, anthropic, etc.
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Settings {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  theme                         String   @default("light")
  sidebarState                  String   @default("open")
  defaultProvider               String? // openai, anthropic, gemini, openrouter
  defaultModel                  String?  @db.Text // JSON string: {"openai": "gpt-4o-mini", "anthropic": "claude-3-5-sonnet-20241022", ...}
  defaultImageProvider          String? // fal, openai-dalle, replicate
  defaultImageModel             String?  @db.Text // JSON string with model per provider: {"fal": "fal-ai/flux/schnell", "openai-dalle": "dall-e-3", ...}
  defaultImageStyle             String?  @db.Text // Default style instructions for image generation
  defaultImagePromptLlmProvider String? // LLM provider for image prompt generation (openai, anthropic, gemini, openrouter)
  defaultImagePromptLlmModel    String? // LLM model for image prompt generation
  writingStyle                  String?  @db.Text // Writing style description for AI-generated posts
  telegramChatId                String? // Default Telegram channel/chat ID (e.g., "@channelname" or numeric ID)
  // Per-user ElevenLabs voiceover (Wave 2)
  elevenLabsVoiceId             String?
  elevenLabsModelId             String?  @default("eleven_multilingual_v2")
  voiceoverEnabled              Boolean  @default(false)
  voiceoverStability            Float    @default(0.5)
  voiceoverSimilarity           Float    @default(0.75)
  voiceoverSpeed                Float    @default(1.0)
  socialTimezone                String?  @default("America/New_York")
  socialAutomationEnabled       Boolean  @default(true)
  lastLogin                     DateTime @default(now())
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Template {
  id                String   @id @default(cuid())
  userId            String
  name              String
  tone              String // professional, casual, inspirational, question-based, storytelling
  description       String
  linkedinTemplate  String   @db.Text
  twitterTemplate   String   @db.Text
  facebookTemplate  String?  @db.Text
  instagramTemplate String?  @db.Text
  telegramTemplate  String?  @db.Text
  threadsTemplate   String?  @db.Text
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ensure only one default template per user
  @@index([userId, isDefault])
  @@map("templates")
}

model SocialConnection {
  id               String    @id @default(cuid())
  userId           String
  platform         String // "linkedin" | "twitter" | "facebook" | "instagram" | "threads" (Note: Telegram uses ApiKey, not OAuth)
  appType          String? // "personal" | "company" - for LinkedIn to distinguish between Personal Profile and Company Pages apps (null for other platforms)
  accessToken      String    @db.Text // OAuth access token (encrypted)
  refreshToken     String?   @db.Text // OAuth refresh token (encrypted, if applicable)
  tokenExpiry      DateTime? // When the access token expires
  platformUserId   String? // The user's ID on the social platform
  platformUsername String? // The user's username/handle
  postTargetType   String? // "personal" | "page" - for LinkedIn and Facebook
  selectedPageId   String? // The selected page ID (for LinkedIn Company Pages or Facebook Pages)
  isActive         Boolean   @default(true) // Can be disabled without deleting
  lastUsed         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One connection per platform per user (for LinkedIn, one per appType: 'personal' or 'company')
  // For other platforms, appType is null, so only one connection per platform
  @@unique([userId, platform, appType])
  @@index([userId, isActive])
  @@index([userId, platform, appType])
  @@map("social_connections")
}

model TwitterApiRequest {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String // e.g., "POST /2/tweets", "POST /2/media/upload"
  statusCode   Int? // HTTP status code (null if request failed before response)
  success      Boolean // Whether the request succeeded
  errorMessage String?  @db.Text // Error message if failed
  requestedAt  DateTime @default(now()) // When the request was made

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@map("twitter_api_requests")
}

// Replaces the in-memory Map in src/lib/oauth.ts with a durable, multi-instance-safe store.
// States expire after 10 minutes; a cleanup job purges rows older than expiresAt.
model OAuthState {
  state        String   @id
  clerkId      String
  platform     String // "linkedin" | "twitter" | "facebook" | "instagram" | "threads"
  codeVerifier String?
  target       String? // "personal" | "company" (LinkedIn only)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([clerkId, platform])
  @@map("oauth_states")
}

// ─────────────────────────────────────────────
// Article Pipeline
// ─────────────────────────────────────────────

model Media {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  s3Key    String
  url      String
  altText  String?
  mimeType String?
  width    Int?
  height   Int?

  source    String    @default("upload") // upload | ai_featured | ai_social | diagram
  title     String?
  prompt    String?   @db.Text
  provider  String?
  jobId     String?
  deletedAt DateTime?

  createdAt DateTime @default(now())

  sitePageFeaturedImages SitePage[] @relation("SitePageFeaturedImage")

  @@index([userId])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, source])
  @@map("media")
}

// One-off async video generation job for the dashboard composer (video reel,
// hook video, quote video). These run for several minutes — far longer than a
// serverless/proxy request will stay open — so the route enqueues a job and the
// worker processes it; the client polls this row for the result.
model VideoGenerationJob {
  id        String   @id @default(cuid())
  userId    String
  postType  String // video_reel | hook_video | quote_video
  status    String   @default("pending") // pending | processing | completed | failed
  content   String // raw idea / source text the asset is generated from
  title     String?
  videoUrl  String?
  mediaId   String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("video_generation_jobs")
}

model WordPressConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String
  siteUrl           String
  username          String
  appPassword       String    @db.Text
  defaultAuthorId   Int?
  defaultStatus     String    @default("draft")
  defaultCategoryId Int?
  lastVerifiedAt    DateTime?
  lastError         String?
  seoPlugin         String? // yoast | rankmath | aioseo | seopress | theseoframework
  topics            Topic[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, siteUrl])
  @@index([userId])
  @@map("wordpress_connections")
}

model Topic {
  id                         String               @id @default(cuid())
  userId                     String
  user                       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic                      String
  // Null = an unscheduled "idea" in the idea bank. A date = scheduled (the
  // primary article topic for that day).
  scheduledDate              DateTime?
  excludedKeywords           String[]
  status                     String               @default("pending") // idea | pending | ... (idea = unscheduled brainstorm)
  source                     String?              @default("manual") // idea | csv | article_calendar | manual
  notes                      String?              @db.Text // free-form note captured with an idea
  mode                       String               @default("social_only") // social_only | article_first | article_only
  defaultOutputTargets       String[]
  wordPressConnectionId      String?
  wordPressConnection        WordPressConnection? @relation(fields: [wordPressConnectionId], references: [id])
  slug                       String?
  category                   String?
  publishingDate             DateTime?
  outlineFrameworkNumber     Int?
  outlineSpecialInstructions String?              @db.Text // per-article focus areas / special notes for the outline
  realCaseStudies            String?              @db.Text // per-article real anecdotes or case studies (optional)
  outlineFrameworkSource     String? // diagnostic: 'user' | 'csv' | 'llm_assigned'
  wpCategoryId               Int? // AI-selected WP category when site linked
  wpTagIds                   Int[]                @default([]) // AI-selected WP tag IDs when site linked
  skipSocialMedia            Boolean              @default(false)
  articleJobs                ArticleJob[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([userId])
  @@index([scheduledDate])
  @@index([status])
  @@index([mode])
  @@map("topics")
}

model ArticleJob {
  id                   String                @id @default(cuid())
  topicId              String
  topic                Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               String                @default("pending") // pending | in_progress | completed | approved | enriched | published | exported | failed
  currentStep          Int                   @default(0)
  enrichmentJobId      String?
  totalCost            Float                 @default(0)
  totalTokens          Int                   @default(0)
  createdAt            DateTime              @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  approvedAt           DateTime?
  enrichedAt           DateTime?
  pipelineSteps        PipelineStep[]
  sitePage             SitePage?
  errorLogs            ErrorLog[]
  outputAttempts       OutputAttempt[]
  llmUsage             LLMUsage[]
  syndicationArticles  SyndicationArticle[]
  socialAutomationRuns SocialAutomationRun[]
  articleEmailCampaign ArticleEmailCampaign?

  @@index([userId])
  @@index([status])
  @@map("article_jobs")
}

model SyndicationArticle {
  id           String     @id @default(cuid())
  jobId        String
  job          ArticleJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId       String
  platform     String // 'linkedin' | 'medium'
  title        String
  content      String     @db.Text
  status       String     @default("pending") // pending | completed | failed
  errorMessage String?    @db.Text
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  cost         Float      @default(0)
  provider     String?
  model        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([jobId, platform])
  @@index([userId])
  @@map("syndication_articles")
}

// Promotional email sent to a GHL smart list (tag) for each published article.
// One row per article job. Generated from the article via PromptTemplate step 32,
// then created + scheduled as a GHL Email Campaign on the publish date.
model ArticleEmailCampaign {
  id            String     @id @default(cuid())
  jobId         String     @unique
  job           ArticleJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId        String
  subject       String
  bodyHtml      String     @db.Text
  status        String     @default("pending") // pending | generated | scheduled | sent | failed
  ghlCampaignId String?
  tagId         String? // tag/smart-list id snapshot used at send time
  tagName       String?
  scheduledFor  DateTime?
  sentAt        DateTime?
  errorMessage  String?    @db.Text
  inputTokens   Int        @default(0)
  outputTokens  Int        @default(0)
  cost          Float      @default(0)
  provider      String?
  model         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([status])
  @@map("article_email_campaigns")
}

model PipelineStep {
  id               String          @id @default(cuid())
  jobId            String
  job              ArticleJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stepNumber       Int
  stepName         String
  status           String          @default("pending") // pending | running | completed | failed
  provider         String?
  model            String?
  promptTemplateId String?
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id])
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  totalTokens      Int             @default(0)
  cost             Float           @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  duration         Int?
  output           String?         @db.Text
  errorMessage     String?         @db.Text
  retryCount       Int             @default(0)

  @@unique([jobId, stepNumber])
  @@map("pipeline_steps")
}

model PromptTemplate {
  id              String         @id @default(cuid())
  stepNumber      Int            @unique
  stepName        String
  systemPrompt    String?        @db.Text
  userPrompt      String         @db.Text
  variables       Json?
  defaultProvider String         @default("gemini")
  defaultModel    String         @default("gemini-2.5-flash")
  maxTokens       Int?
  version         Int            @default(1)
  isActive        Boolean        @default(true)
  // Stable string key for non-pipeline prompts looked up by name (e.g. newsletter `nl_*`).
  // Nullable so existing rows stay keyed by stepNumber.
  key             String?        @unique
  pipelineSteps   PipelineStep[]

  @@map("prompt_templates")
}

model SitePage {
  id                   String                @id @default(cuid())
  jobId                String?               @unique
  job                  ArticleJob?           @relation(fields: [jobId], references: [id])
  userId               String
  slug                 String
  title                String
  bodyHtml             String?               @db.Text
  originalBodyHtml     String?               @db.Text
  featuredImageId      String?
  featuredImage        Media?                @relation("SitePageFeaturedImage", fields: [featuredImageId], references: [id])
  publishedAt          DateTime?
  readingTime          Int?
  seoTitle             String?
  seoDescription       String?
  citations            Json?
  disclaimer           String?               @db.Text
  excerpt              String?               @db.VarChar(160)
  primaryKeyword       String?
  schemaJson           String?               @db.Text // JSON-LD from Step 16 (generate_schema_markup)
  enrichmentStatus     String                @default("pending") // pending | in_progress | completed | failed
  enrichmentError      String?
  enrichedAt           DateTime?
  keyTakeawaysHtml     String?               @db.Text
  tocHtml              String?               @db.Text
  diagrams             ArticleDiagram[]
  sectionEnrichments   SectionEnrichment[]
  socialAutomationRuns SocialAutomationRun[]

  @@unique([userId, slug])
  @@index([primaryKeyword])
  @@index([userId])
  @@map("site_pages")
}

model SectionEnrichment {
  id             String   @id @default(cuid())
  sitePageId     String
  sitePage       SitePage @relation(fields: [sitePageId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position       Int
  originalH2     String
  question       String?
  summary        String?  @db.Text
  questionSource String?
  llmProvider    String?
  llmModel       String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  cost           Float    @default(0)
  createdAt      DateTime @default(now())

  @@unique([sitePageId, position])
  @@index([userId, question])
  @@index([sitePageId])
  @@map("section_enrichments")
}

model ArticleDiagram {
  id             String    @id @default(cuid())
  sitePageId     String
  sitePage       SitePage  @relation(fields: [sitePageId], references: [id], onDelete: Cascade)
  position       Int
  sectionAnchor  String
  sectionTitle   String
  caption        String?
  mermaidSyntax  String    @db.Text
  svgContent     String    @db.Text
  svgS3Key       String?
  pngS3Key       String?
  pngWidth       Int?
  pngHeight      Int?
  pngDarkS3Key   String?
  pngDarkWidth   Int?
  pngDarkHeight  Int?
  pngGeneratedAt DateTime?
  llmProvider    String
  llmModel       String
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  cost           Float     @default(0)
  createdAt      DateTime  @default(now())

  @@unique([sitePageId, position])
  @@index([sitePageId])
  @@map("article_diagrams")
}

model OutputAttempt {
  id           String     @id @default(cuid())
  jobId        String
  job          ArticleJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId       String
  target       String // wordpress | html | bundle | preview
  targetRefId  String?
  status       String     @default("pending") // pending | success | failed
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  durationMs   Int?
  resultUrl    String?
  errorMessage String?
  payloadHash  String?

  @@index([jobId])
  @@index([userId, target])
  @@map("output_attempts")
}

model ErrorLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  jobId        String?
  job          ArticleJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  errorType    String
  errorMessage String      @db.Text
  stackTrace   String?     @db.Text
  context      Json?
  resolved     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([jobId])
  @@index([createdAt])
  @@map("error_logs")
}

model LLMUsage {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String?
  job          ArticleJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  stepNumber   Int?
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  cost         Float
  source       String // article-pipeline | social-only | enrichment | image-gen
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([jobId])
  @@index([source])
  @@map("llm_usage")
}

model SystemApiKey {
  id           String   @id @default(cuid())
  provider     String   @unique // gemini | openai | anthropic | openrouter | fal-ai
  encryptedKey String   @db.Text
  updatedAt    DateTime @updatedAt

  @@map("system_api_keys")
}

// Admin-managed background music library for social video posts.
// Tracks are loudness-normalized (EBU R128) and transcoded to AAC on upload,
// so mix-time levels are predictable for every track.
model MusicTrack {
  id        String   @id @default(cuid())
  title     String
  s3Key     String // system/music/<id>.m4a (normalized AAC)
  url       String // CDN URL
  duration  Float // seconds, probed after normalization
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("music_tracks")
}

// ─── Article Pipeline V2 Models ───────────────────────────────────────────────

model OutlineFramework {
  id          String   @id @default(cuid())
  number      Int      @unique // 1..12 — matches CSV "Outline Framework" column
  label       String // e.g., "Pillar / Educational Foundation"
  description String?  @db.Text // "when to use" — used by LLM auto-assignment
  body        String   @db.Text // full framework body injected into prompts
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("outline_frameworks")
}

model PlatformSettings {
  id               String   @id @default("singleton") // only one row
  googleGuidelines String?  @db.Text // Google Helpful Content guidelines text
  schemaTypeRules  Json? // [{ keyword, articleType, publisherType }]
  // From address for transactional emails (newsletter "ready for review", etc.).
  // The Resend API key itself is a SystemApiKey row (provider "resend").
  transactionalEmailFrom String?
  updatedAt        DateTime @updatedAt

  @@map("platform_settings")
}

model BrandSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Article brand context (used by prompt variable resolver)
  geolocation           String? @db.Text
  industry              String? @db.Text // e.g. Chiropractic, Accounting — primes LLM prompts
  specialization        String? @db.Text // legacy free-text (fallback for {{specialization}}); superseded by primarySpecialization
  // Deterministic specializations (Specialization.key). Multi-select; one primary
  // drives the newsletter calendar. hemisphereOverride applies only for edge countries.
  specializations       String[] // selected Specialization.key values
  primarySpecialization String? // the primary Specialization.key (drives calendar routing + {{specialization}})
  hemisphereOverride    String? // 'north' | 'south' — honored only when the client's country is an edge country
  businessDescription   String? @db.Text // free-text: what the business does, who it serves
  who                   String? @db.Text // target audience description
  ourExperience         String? @db.Text // firm / author experience blurb
  articleGoal           String? @db.Text // strategic goal of each article
  specialInstructions   String? @db.Text // global special instructions injected into every article
  defaultAuthorName     String?
  defaultAuthorWebsite  String?
  defaultAuthorLinkedIn String? // personal LinkedIn URL for schema + author profile
  defaultAuthorJobTitle String? // e.g. "Chiropractor" — author.jobTitle in JSON-LD
  defaultAuthorAlumniOf String? // institution name — author.alumniOf in JSON-LD
  schemaArticleType     String? // override auto-derived @type, e.g. "MedicalArticle"

  // Organization / schema markup fields (used in Wave 4)
  organizationName         String?
  organizationWebsite      String?
  organizationEmail        String?
  organizationPhone        String?
  // Structured address — sub-fields (new); combined string kept for backward compat
  addressLine1             String?
  addressLine2             String?
  addressLocality          String? // city
  addressRegion            String? // state / province
  postalCode               String?
  addressCountryName       String? // full country name, e.g. "Australia"
  organizationAddress      String? @db.Text // computed combined string (legacy + fallback)
  organizationCountryCode  String? @db.VarChar(2) // ISO 3166-1 alpha-2, auto-derived from addressCountryName
  organizationLogoUrl      String? // CDN URL for the business logo (used in schema publisher.logo)
  socialLogoUrl            String? // optional override for social quote cards / compositors; falls back to organizationLogoUrl
  socialAccountName        String? // social handle / display name for quote cards (e.g. "hormozi"); falls back to organizationName
  instagramVerified        Boolean @default(false) // show Instagram-style blue verified badge on quote cards
  videoSpecialInstructions String? @db.Text // client-specific instructions injected into the Fal.ai video prompt (e.g. style, restrictions)
  socialCallToAction       String? @db.Text // what the social posts should promote / drive toward (injected as {{call_to_action}})
  googleBusinessProfileUrl String? // GBP / g.page / Maps share URL → sameAs + hasMap in JSON-LD
  socialMediaLinks         Json? // [{ platform: string, url: string }]

  // Mermaid diagrams (article enrichment — theme injected into %%{init}%% )
  diagramPrimaryColor     String?
  diagramPrimaryTextColor String?
  diagramSecondaryColor   String?
  diagramLineColor        String?
  diagramTextColor        String?
  diagramFontFamily       String?

  // Article typography (standalone HTML export only — not WordPress)
  articleFontFamily   String?
  articleFontWeight   String?
  articleFontSizeBase String?

  // Newsletter email template (end-user customizable; renderer supplies sensible defaults)
  nlHeaderBgColor     String?
  nlFooterBgColor     String?
  nlFontFamily        String?
  nlFontColor         String?
  nlHeadingFontWeight String?
  nlBodyFontWeight    String?
  nlLinkColor         String?
  // Four content-section band colors (cycled) + header logo (header band only)
  nlSectionColor1     String?
  nlSectionColor2     String?
  nlSectionColor3     String?
  nlSectionColor4     String?
  nlLogoUrl           String? // legacy single newsletter logo (read fallback)
  nlLogoWidth         Int? // header logo width (px)
  // Auto-generated light/dark logo variants (one upload → white + navy transparent)
  nlLogoSourceUrl     String? // original upload, kept so re-processing needs no re-upload
  nlLogoLightUrl      String? // white-on-transparent (for dark backgrounds)
  nlLogoDarkUrl       String? // navy-on-transparent (for light backgrounds)
  nlHeaderLogoVariant String? // 'auto' | 'light' | 'dark' (default auto)
  nlFooterLogoVariant String? // 'auto' | 'light' | 'dark' (default auto)
  nlFooterLogoWidth   Int? // footer logo width (px)
  nlFooterDisclaimer  String? @db.Text // editable footer disclaimer (renderer has a default)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_settings")
}

// ─────────────────────────────────────────────
// Newsletter Pipeline (magazine-style)
// ─────────────────────────────────────────────

// Admin-managed content calendar, scoped per industry + specialization.
// Topics are uploaded via CSV; customers are explicitly assigned to a calendar.
// Admin-managed list of available specializations (deterministic; replaces the
// old free-text specialization). `key` is an immutable slug referenced by
// calendars + clients; `label` is the display name.
model Specialization {
  id        String   @id @default(cuid())
  key       String   @unique // immutable slug, e.g. "family_care"
  label     String // display name, e.g. "Family Care"
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("specializations")
}

model NewsletterCalendar {
  id              String            @id @default(cuid())
  name            String
  industry        String // matches BrandSettings.industry
  specializationKey String? // → Specialization.key
  hemisphere      String? // 'north' | 'south'
  topics          NewsletterTopic[]
  assignments     User[]            @relation("UserNewsletterCalendar")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([specializationKey, hemisphere])
  @@map("newsletter_calendars")
}

// One dated edition's source content (one CSV row). Optional columns drive
// industry modules / secondary article purely by presence.
model NewsletterTopic {
  id               String             @id @default(cuid())
  calendarId       String
  calendar         NewsletterCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date             DateTime
  topic            String // feature article
  bullet1          String
  bullet2          String
  bullet3          String
  secondaryTopic   String? // → second (specialization) article; CSV column `secondary_article`
  recipe           String? // recipe #1 hint; CSV column `recipe`
  recipe2          String? // recipe #2 hint; CSV column `recipe_2`
  videoUrl         String? // explicit video override
  // shared research write-back (computed once, reused across customers in this calendar)
  research         Json? // { video:{...}, recipe:{...}, teaserSources:[{bullet,url,extract}] }
  researchStatus   String             @default("pending") // pending|complete|partial|failed
  newsletters      Newsletter[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([calendarId, date])
  @@index([calendarId])
  @@map("newsletter_topics")
}

// Per-customer voiced newsletter for one topic. JSON per section so a
// single-section regenerate writes one column.
model Newsletter {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId          String
  topic            NewsletterTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status           String          @default("pending") // pending|researching|generating|ready_for_review|approved|scheduled|sent|failed
  // voiced content — JSON per section
  featureArticle   Json? // {title,teaser,tldr,body,imageUrl}
  secondaryArticle Json?
  teasers          Json? // [{title,body,cta,link} ×3]
  quickHits        Json? // {tips:[..4], facts:[..4]}
  fun              Json? // {triviaQuestion,triviaAnswer,joke}
  modules          Json? // {recipe?,kidsSnack?,techFreeActivity?}
  subjectLine      String?
  previewText      String?
  summaryTitle     String? // LLM 3-word cover title
  summaryImageUrl  String?         @db.Text // composited cover image URL
  renderedHtml     String?         @db.Text
  validation       Json? // completion score + issues
  // delivery
  ghlCampaignId    String?
  scheduledFor     DateTime?
  sentAt           DateTime?
  approvedAt       DateTime?
  // Set when the batch "ready for review" email has been sent for this edition
  // (prevents re-notifying on subsequent batch completions).
  notifiedAt       DateTime?
  // cost
  cost             Float           @default(0)
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, topicId])
  @@index([userId, status])
  @@index([topicId])
  @@map("newsletters")
}

// Per-customer promotional offers included in their newsletter. Evergreen
// (no dates) render after the feature article; seasonal (date window) render
// after "Tips Of The Day" and auto-expire.
model NewsletterOffer {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  ctaLabel  String?
  ctaUrl    String?
  imageUrl  String?   @db.Text // optional 16:9 banner (AI-generated or uploaded)
  startDate DateTime? // null + null endDate = evergreen
  endDate   DateTime?
  enabled   Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, enabled])
  @@map("newsletter_offers")
}
